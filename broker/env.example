# LEASE_TTL, SSE_HEARTBEAT, SSE_DRAIN_TIMEOUT, BLOCKING_TIMEOUT and IDLE_CLOSE use seconds.
LEASE_TTL=600
THREAD_CAP=20
MAX_REOPENS=3
SSE_HEARTBEAT=15
SSE_BUFFER_BYTES=4194304
SSE_DRAIN_TIMEOUT=30
MAX_BODY_BYTES=65536
MAX_MESSAGE_CHARS=16000
INBOX_LIMIT=100
PLANNING_MAX_ITEMS=128
PLANNING_MAX_ITEM_CHARS=512
DECISION_LIMIT=100
DECISION_MAX_CHARS=2000
DECISION_PAGE_BYTES=16000
DECISION_MAX_PER_WORKSTREAM=1000
OVERLAP_LIMIT=10
OVERLAP_PAIR_LIMIT=10
OVERLAP_SCAN_LIMIT=100
BLOCKING_TIMEOUT=1800
IDLE_CLOSE=86400
MAINTENANCE_INTERVAL_MS=1000
# BROKER_WEBHOOK_URL=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_RETRY_MS=1000
WEBHOOK_RETRY_MAX_MS=30000
WEBHOOK_BATCH=10

# BROKER_DEFAULT_OWNER=
WORKSPACE_LIMIT=20
