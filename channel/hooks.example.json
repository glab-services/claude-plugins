{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/claude-plugins/channel/session-start.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
