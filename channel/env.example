BROKER_URL=http://127.0.0.1:8091
BROKER_TOKEN=replace-with-your-developer-token
# Pin this per (client, workspace); share it with the MCP server and hook.
# Without the hook, omitting this still generates a fresh UUID per process.
# CHANNEL_SESSION_ID=my-manager
CHANNEL_WORKSPACE=default
# CHANNEL_IDLE_EXIT_MS=0
CHANNEL_ROLE=worker
CHANNEL_MODE=push
CHANNEL_HEARTBEAT_MS=30000
CHANNEL_POLL_MS=1000
CHANNEL_RETRY_MAX_MS=30000
CHANNEL_REQUEST_TIMEOUT_MS=10000
CHANNEL_STREAM_IDLE_MS=45000
CHANNEL_BUFFER_LIMIT=1000
CHANNEL_MAX_FRAME_BYTES=1048576
HOOK_MESSAGE_LIMIT=20
HOOK_CONTEXT_MAX_CHARS=9500
HOOK_INPUT_MAX_BYTES=65536
